{
  "expo": {
    "name": "MALANG",
    "slug": "malang",
    "scheme": "malang",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-sqlite", { "useSQLCipher": true }],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.malang.app"
    },
    "android": {
      "package": "com.malang.app",
      "allowBackup": false
    }
  }
}
